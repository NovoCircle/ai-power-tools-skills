# Local dev artifacts
.venv/
__pycache__/
*.pyc
.DS_Store

# Tool caches. Not assets; the gate skips them too.
.pytest_cache/

# Staging area built by tools/publish-bundle.py. Regenerated on demand and
# never committed: it is a flattened copy of tracked files.
.release-staging/

# Built by tools/build-plugin.py. Regenerated on demand, never committed.
dist/

# Staging clone built by tools/publish-plugin.py. Regenerated on demand and
# never committed: it is a clone of the releases repository.
.plugin-release-staging/
